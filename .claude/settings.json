{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 .claude/hooks/agent-status.py start 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 .claude/hooks/agent-status.py end 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
